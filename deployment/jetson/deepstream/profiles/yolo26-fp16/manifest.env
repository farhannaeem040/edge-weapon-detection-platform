# Model profile manifest for "yolo26-fp16" (FS-13/IP-15 T-296).
#
# Consumed by deploy-engine.sh to verify an engine before installing it as
# /opt/weapon-detection/models/yolo26-fp16/model.engine. Flat KEY=VALUE — no quoting, no expansion,
# parsed with the same `sed -n 's/^KEY=//p'` style the rest of this repo's deployment scripts use.
#
# This is the ONLY place these model-specific values are allowed to live — never in Agent source,
# never in DeepStreamProcessManager, never in AgentSettings.
#
# ENGINE_SHA256 is the raw TensorRT engine exported from the custom YOLO26 gun/knife detector
# (best_deepstream.engine) — independently verified on-device with TensorRT 8.5.2.2: input binding
# `images` = 1x3x640x640 FLOAT, output binding `output0` = 1x300x6 FLOAT. This is NOT `best.engine`
# (the Ultralytics-metadata-wrapped file, which fails DeepStream deserialization with a Magic-tag
# mismatch) — the two have distinct SHA-256 checksums.

PROFILE_NAME=yolo26-fp16
ENGINE_SHA256=ed4810762244c78d04be7617b37e2bd20f8c8252b0f1ed2b5c33475e6eb3f9c1
ENGINE_PRECISION=FP16
INPUT_DIMENSIONS=3;640;640
CLASS_COUNT=2
LABELS_FILE=labels.txt
OUTPUT_BLOB_NAMES=output0
PARSER_LIB=/opt/weapon-detection/lib/yolo26/libnvdsinfer_custom_impl_Yolo.so
PARSER_FUNC=NvDsInferParseYolo
DEEPSTREAM_VERSION=6.2
TENSORRT_VERSION=8.5.2
TARGET_DEVICE=NVIDIA Orin NX (aarch64, JetPack 5.1.2 / L4T R35.5.0)
VALIDATED_DATE=2026-08-12
VALIDATED_STATUS=validated
