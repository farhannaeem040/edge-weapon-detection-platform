# Model profile manifest for "yolov4-fp16" (IP-06 T-70, FS-04 §8.3).
#
# Consumed by deploy-engine.sh to verify an engine before installing it as
# /opt/weapon-detection/models/yolov4-fp16/model.engine. Flat KEY=VALUE — no quoting, no expansion,
# parsed with the same `sed -n 's/^KEY=//p'` style the rest of this repo's deployment scripts use.
#
# This is the ONLY place these model-specific values are allowed to live — never in Agent source,
# never in DeepStreamProcessManager, never in AgentSettings.

PROFILE_NAME=yolov4-fp16
ENGINE_SHA256=2298d1a3d85ef9ff9d630593a01d70532df3c3b484c9aa2c9a4cc2f78081bff8
ENGINE_PRECISION=FP16
INPUT_DIMENSIONS=3;640;640
CLASS_COUNT=2
LABELS_FILE=labels.txt
OUTPUT_BLOB_NAMES=BatchedNMS
PARSER_LIB=/opt/nvidia/deepstream/deepstream-6.2/lib/libnvds_infercustomparser.so
PARSER_FUNC=NvDsInferParseCustomBatchedNMSTLT
DEEPSTREAM_VERSION=6.2
TENSORRT_VERSION=8.5.2
TARGET_DEVICE=NVIDIA Orin NX (aarch64, JetPack 5.1.2 / L4T R35.5.0)
VALIDATED_DATE=2026-07-08
VALIDATED_STATUS=validated
