# Weapon Detection Jetson Agent — environment template (IP-02 T-41, §8).
#
# install.sh copies this to /etc/weapon-detection-agent/agent.env (root-owned, 0600) ONLY when no
# real env file already exists — it never overwrites a deployed one. Edit the deployed copy, not
# this template.
#
# This file holds NON-SECRET bootstrap configuration only. It MUST NEVER contain:
#   - WDA_ACTIVATION_KEY (provision it out-of-band via set-activation-key.sh into the
#     0600 config/activation-key file — the env var would leak into the process table and journald)
#   - a device shared secret, SQL credential, admin credential, or JWT signing key
#
# Uses the exact T-32 WDA_ setting names.

# Backend base URL (required). The central platform's single public origin over Tailscale.
WDA_BACKEND_BASE_URL=http://100.77.146.5:8080

# Agent filesystem root (pinned to the installed layout on the Jetson).
WDA_ROOT_PATH=/opt/weapon-detection

# Activation-request HTTP timeout, seconds (optional; default 10).
WDA_HTTP_TIMEOUT_SECONDS=10

# Log level: DEBUG | INFO | WARNING | ERROR | CRITICAL (optional; default INFO).
WDA_LOG_LEVEL=INFO

# Credential-validation polling interval, seconds (optional; default 30). How often the running
# Agent re-checks its shared secret against POST /api/v1/device/credentials/validate (IP-05 T-59).
WDA_CREDENTIAL_VALIDATION_INTERVAL_SECONDS=30

# DeepStream process supervision (IP-06; optional). Defaults to false — DeepStream never launches
# until explicitly enabled. See deployment/jetson/deepstream/README.md before setting this true.
# WDA_DEEPSTREAM_EXECUTABLE_PATH (not set here) defaults to /usr/bin/deepstream-app — the reference
# binary, the safe, IP-06 T-77-proven runtime. It is only ever repointed at the DeepStream Bridge's
# launcher as a deliberate operator decision, alongside WDA_DETECTION_EVENTS_ENABLED below.
WDA_DEEPSTREAM_ENABLED=false

# --- Detection Event Bridge (IP-07, FS-05 §9; optional). All default to safe/off — a fresh or
# freshly-updated deployment sends no detection traffic and starts no Unix-socket listener until an
# operator deliberately opts in. See deployment/jetson/deepstream/bridge/README.md before enabling.

# Kill switch for this feature. Defaults to false: no DetectionIngestHandler is constructed, no
# socket is bound, no schema v3 data is written, regardless of WDA_DEEPSTREAM_ENABLED above.
WDA_DETECTION_EVENTS_ENABLED=false

# Enabling detection events ALSO requires repointing WDA_DEEPSTREAM_EXECUTABLE_PATH at the Bridge's
# launcher (the reference binary above has no way to publish detection events at all — the Agent
# refuses to start with WDA_DETECTION_EVENTS_ENABLED=true left against the default executable path,
# T-90's preflight check). Uncomment BOTH of the following only when deploy-bridge.sh has already
# built a working Bridge venv (deployment/jetson/deepstream/bridge/README.md):
#WDA_DETECTION_EVENTS_ENABLED=true
#WDA_DEEPSTREAM_EXECUTABLE_PATH=/opt/weapon-detection/deepstream-bridge/run.sh

# Detections below this confidence are rejected (optional; default 0.50).
#WDA_DETECTION_MIN_CONFIDENCE=0.50

# Duplicate-suppression cooldown window in seconds, keyed on (device id, camera id, class name)
# (optional; default 5.0).
#WDA_DETECTION_COOLDOWN_SECONDS=5.0

# Bounded internal queue capacity between socket reads and SQLite writes (optional; default 1000).
#WDA_DETECTION_QUEUE_CAPACITY=1000

# The single configured camera identity attached to every accepted event (optional; default
# "camera1"). Never trusted from the wire payload.
#WDA_DETECTION_CAMERA_ID=camera1

# The Unix domain socket DetectionIngestHandler listens on and the Bridge's run.sh writes to
# (optional; default shown below — this is also run.sh's own literal fallback when this variable is
# unset, so the two never need to be kept in sync by hand; T-90 adds a static check confirming they
# still match).
#WDA_DETECTION_SOCKET_PATH=/opt/weapon-detection/runtime/detection.sock

# --- Detection Event Backend Sync (IP-08, FS-06; optional). Drains already-persisted DetectionEvent
# rows to the Backend's POST /api/v1/sync/events. Metadata synchronization only — snapshot capture/
# upload is NOT implemented; Alert.SnapshotReference stays null for every event this feature
# delivers. See deployment/jetson/README.md before enabling.

# Kill switch for this feature. MUST stay false until the isolated end-to-end staging test (IP-08
# Phase 16) has passed for this deployment — do not flip this true based on unit tests alone.
WDA_DETECTION_SYNC_ENABLED=false

# How often the worker checks the local outbox when it is empty, seconds (optional; default 1.0).
#WDA_DETECTION_SYNC_INTERVAL_SECONDS=1.0

# Bounded batch size drained per sync request, 1-100 (optional; default 25).
#WDA_DETECTION_SYNC_BATCH_SIZE=25

# First backoff delay after a whole-batch failure, seconds (optional; default 1.0). Doubles on each
# consecutive failure up to WDA_DETECTION_SYNC_MAX_BACKOFF_SECONDS.
#WDA_DETECTION_SYNC_INITIAL_BACKOFF_SECONDS=1.0

# Backoff cap, seconds (optional; default 60.0). Must be >= the initial backoff above.
#WDA_DETECTION_SYNC_MAX_BACKOFF_SECONDS=60.0

# --- Server-driven Device Camera configuration (FS-11 §11, IP-13; optional). Defaults to false —
# the Agent keeps using the static deepstream-app.txt source and WDA_DETECTION_CAMERA_ID above until
# an operator deliberately opts in, after this feature has passed isolated validation. When enabled,
# the Backend's assigned Camera(s) for this Device become authoritative and the Bridge is started/
# restarted by the DeviceConfigurationCoordinator instead of a static one-shot launch.
WDA_DEVICE_CONFIG_ENABLED=false

# How often the coordinator polls the Backend for a configuration change, seconds (optional;
# default 30.0).
#WDA_DEVICE_CONFIG_REFRESH_SECONDS=30.0

# Maximum enabled-Camera count this Agent will accept in one configuration (optional; default 8) —
# a bound against a malformed/hostile response, not a hardware claim about stream capacity.
#WDA_DEVICE_CONFIG_MAX_CAMERAS=8

# How old a cached configuration may be before the coordinator refuses to apply it at startup
# without a fresh Backend fetch first, seconds (optional; default 0 = no forced expiry — an edge
# Device may be offline indefinitely and must keep running its last-known-good pipeline).
#WDA_DEVICE_CONFIG_CACHE_MAX_AGE_SECONDS=0
