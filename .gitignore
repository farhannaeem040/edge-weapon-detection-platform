# .NET build artifacts
[Bb]in/
[Oo]bj/
*.user

# Angular / Node (added when frontend is scaffolded)
node_modules/
dist/

# Environment / secrets
*.env
.env.*

# ...but the committed placeholder template must stay tracked (it holds no real values).
!.env.example

# Local MCP server config — contains an API key; must never be committed.
mcp.json
.mcp.json

# Local SQLite artifacts (e.g. a stray agent.db from a dev/test run). No .db fixture is tracked;
# the Agent's real store lives under /opt/weapon-detection on the Jetson, never in the repo.
*.db
*.db-journal
*.db-wal
*.db-shm
