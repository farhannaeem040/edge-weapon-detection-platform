                  "  pm.expect(pm.response.json().errorCode).to.eql('VALIDATION_ERROR');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "GET Operational Analytics CSV Export",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/analytics/operational/export?range=last7d&branchId={{branchId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "analytics",
                "operational",
                "export"
              ],
              "query": [
                {
                  "key": "range",
                  "value": "last7d"
                },
                {
                  "key": "branchId",
                  "value": "{{branchId}}"
                }
              ]
            },
            "description": "FS-15 §6.2. Row-level CSV for exactly the filters supplied, generated entirely by the Backend. Columns: Detected At (UTC), Received At (UTC), Delivery Latency (ms), Branch, Camera, Detection Type, Confidence, Status, Snapshot Available. It carries no RTSP URL, CameraKey, snapshot reference, filesystem path, or secret of any kind."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('CSV export returns 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Is a CSV attachment with the documented filename', function () {",
                  "  pm.expect(pm.response.headers.get('Content-Type')).to.include('text/csv');",
                  "  pm.expect(pm.response.headers.get('Content-Disposition'))",
                  "    .to.include('operational-analytics-');",
                  "});",
                  "pm.test('Leaks no RTSP URL, credential, or internal path', function () {",
                  "  const body = pm.response.text();",
                  "  pm.expect(body).to.not.match(/rtsp:\\/\\//i);",
                  "  pm.expect(body).to.not.match(/\\/var\\/lib/i);",
                  "  pm.expect(body).to.not.match(/secret|activationKey/i);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
