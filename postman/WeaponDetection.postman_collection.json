    {
      "name": "Branches",
      "item": [
        {
          "name": "POST Create Branch",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Postman Test Branch\",\n  \"address\": \"123 Test Street\",\n  \"contactDetails\": \"manager@example.com\",\n  \"jetsonHost\": \"{{jetsonHost}}\",\n  \"rtspOutputPort\": {{rtspOutputPort}},\n  \"cameras\": [\n    {\n      \"name\": \"Front Camera\",\n      \"rtspUrl\": \"rtsp://camera.local/front\",\n      \"cameraKey\": \"{{cameraKey}}\"\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/branches",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "branches"
              ]
            },
            "description": "Creates a branch, its first camera, a reserved (unactivated) device, and the first Activation Key, all in one transaction. `jetsonHost`/`rtspOutputPort` are the Jetson's reachable address for annotated stream output (FS-12). `cameraKey` is the human-readable public mount identifier (lowercase letters/digits/hyphens, 3-64 chars, e.g. `front-camera`). Saves branchId, cameraId, and activationKey."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Create branch returns 201', function () {",
                  "  pm.response.to.have.status(201);",
                  "});",
                  "",
                  "const body = pm.response.json();",
                  "const data = body.data;",
                  "if (data) {",
                  "  if (data.branchId) pm.environment.set('branchId', data.branchId);",
                  "  if (data.activationKey) pm.environment.set('activationKey', data.activationKey);",
                  "  if (data.cameras && data.cameras.length > 0) {",
                  "    pm.environment.set('cameraId', data.cameras[0].cameraId);",
                  "    pm.environment.set('cameraKey', data.cameras[0].cameraKey);",
                  "  }",
                  "}",
                  "",
                  "pm.test('Response carries an activation key', function () {",
                  "  pm.expect(data.activationKey).to.be.a('string').and.not.empty;",
                  "});"
                ]
              }
            }
          ]
        },
