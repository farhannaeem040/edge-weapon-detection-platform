                "type": "text/javascript",
                "exec": [
                  "pm.test('List alerts returns 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const body = pm.response.json();",
                  "const items = body.data && body.data.items;",
                  "if (items && items.length > 0 && !pm.environment.get('alertId')) {",
                  "  pm.environment.set('alertId', items[0].alertId);",
                  "}"
                ]
              }
            }
          ]
