            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Postman Updated Branch\",\n  \"address\": \"456 Updated Street\",\n  \"contactDetails\": \"updated-manager@example.com\",\n  \"cameras\": [\n    {\n      \"cameraId\": \"{{cameraId}}\",\n      \"name\": \"Front Camera Updated\",\n      \"rtspUrl\": \"rtsp://camera.local/front-updated\",\n      \"cameraKey\": \"{{cameraKey}}\"\n    },\n    {\n      \"cameraId\": null,\n      \"name\": \"Rear Camera\",\n      \"rtspUrl\": \"rtsp://camera.local/rear\",\n      \"cameraKey\": \"rear-entrance\"\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/branches/{{branchId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "branches",
                "{{branchId}}"
              ]
            },
            "description": "Updates branch details and reconciles its cameras. An existing `cameraId` updates that camera in place (its `cameraKey` must match what's stored — keys are immutable); a null `cameraId` adds a new camera and requires a fresh `cameraKey`. At least one camera must remain."
          },
