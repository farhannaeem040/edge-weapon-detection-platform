              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Regenerate key returns 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const body = pm.response.json();",
                  "const key = body.data && body.data.activationKey;",
                  "pm.test('Response carries a new activation key', function () {",
                  "  pm.expect(key).to.be.a('string').and.not.empty;",
                  "});",
                  "if (key) {",
                  "  pm.environment.set('activationKey', key);",
                  "}"
                ]
              }
            }
          ]
        }
      ]
