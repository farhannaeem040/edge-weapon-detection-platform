    {
      "name": "Detection Sync (Device credentials)",
      "item": [
        {
          "name": "POST Sync Events",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Device-Id",
                "value": "{{deviceId}}"
              },
              {
                "key": "X-Device-Secret",
                "value": "{{sharedSecret}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"events\": [\n    {\n      \"eventId\": \"{{$guid}}\",\n      \"cameraId\": \"{{cameraId}}\",\n      \"detectedAtUtc\": \"{{$isoTimestamp}}\",\n      \"createdAtUtc\": \"{{$isoTimestamp}}\",\n      \"classId\": 0,\n      \"className\": \"gun\",\n      \"confidence\": 0.87,\n      \"sourceId\": 0,\n      \"frameNumber\": 1234,\n      \"frameWidth\": 1280,\n      \"frameHeight\": 720,\n      \"boundingBox\": {\n        \"left\": 100,\n        \"top\": 80,\n        \"width\": 220,\n        \"height\": 260\n      }\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/sync/events",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "sync",
                "events"
              ]
            },
            "description": "The endpoint the Agent's sync worker calls to hand off its local SQLite outbox of detection events. `cameraId` is the Backend's real Camera GUID (from Branches > Create Branch). One result per submitted event: `accepted`, `duplicate`, `rejected`, or `quota_exceeded` — an `accepted`/`duplicate` result carries the created/existing `alertId`. Up to 100 events per batch. Saves eventId and, if accepted, alertId."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Sync events returns 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const body = pm.response.json();",
                  "const results = body.data && body.data.results;",
                  "pm.test('Response contains one result per submitted event', function () {",
                  "  pm.expect(results).to.be.an('array').with.lengthOf(1);",
                  "});",
                  "",
                  "if (results && results.length > 0) {",
                  "  const result = results[0];",
                  "  pm.environment.set('eventId', result.eventId);",
                  "  if (result.alertId) {",
                  "    pm.environment.set('alertId', result.alertId);",
                  "  }",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "POST Upload Alert Snapshot",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "X-Device-Id",
                "value": "{{deviceId}}"
              },
              {
                "key": "X-Device-Secret",
                "value": "{{sharedSecret}}"
              }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": [],
                  "description": "Select a real JPEG file here in Postman before sending — the server rejects a non-image payload as MALFORMED_IMAGE."
                },
                {
                  "key": "eventId",
                  "value": "{{eventId}}",
                  "type": "text"
                },
                {
                  "key": "sha256",
                  "value": "",
                  "type": "text",
                  "description": "Optional early-reject sanity check only; the server recomputes the SHA-256 itself, so this can be left blank."
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/alerts/{{alertId}}/snapshot",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "alerts",
                "{{alertId}}",
                "snapshot"
              ]
            },
            "description": "The endpoint the Agent's snapshot worker calls to hand off one evidence JPEG per accepted detection event, matched to the Alert created by Sync Events. Needs alertId (from a prior 'accepted' or 'duplicate' Sync Events result) and eventId. Requires a real image file attached in the `file` form field."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Upload snapshot returns 200 or 201', function () {",
                  "  pm.expect([200, 201]).to.include(pm.response.code);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Alerts (Admin)",
      "item": [
        {
          "name": "GET List Alerts",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/alerts?page=1&pageSize=20&sortBy=detectedAtUtc&sortDescending=true",
