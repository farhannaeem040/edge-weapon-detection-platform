    {
      "name": "Device Activation (Device credentials)",
      "item": [
        {
          "name": "POST Activate Device",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"activationKey\": \"{{activationKey}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/activate",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "activate"
              ]
            },
            "description": "The endpoint a Jetson Agent calls to exchange an Activation Key for its permanent DeviceId and shared secret. Exempt from Admin JWT auth — the key itself is the credential. Saves deviceId, sharedSecret, and branchId. sharedSecret is disclosed here only, exactly once."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Activate returns 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const body = pm.response.json();",
                  "const data = body.data;",
                  "if (data) {",
                  "  if (data.deviceId) pm.environment.set('deviceId', data.deviceId);",
                  "  if (data.sharedSecret) pm.environment.set('sharedSecret', data.sharedSecret);",
                  "  if (data.branchId) pm.environment.set('branchId', data.branchId);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "POST Validate Device Credentials",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "X-Device-Id",
                "value": "{{deviceId}}"
              },
              {
                "key": "X-Device-Secret",
                "value": "{{sharedSecret}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/device/credentials/validate",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "device",
                "credentials",
                "validate"
              ]
            },
            "description": "The endpoint a running Agent calls to confirm its stored credentials are still valid (e.g. have not been revoked by an activation-key regeneration). Detect-only: no body, no request payload, and the success response carries no data — just `{success: true}`. A revoked/wrong credential returns a uniform 401."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Validate credentials returns 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});"
                ]
              }
            }
          ]
        },
