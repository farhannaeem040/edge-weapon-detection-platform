              "raw": "{\n  \"credentialIdentifier\": \"{{adminIdentifier}}\",\n  \"password\": \"{{adminPassword}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "login"
              ]
            },
            "description": "Logs in as the admin user and saves the JWT into the `token` environment variable. Run this first — every Admin-JWT request below depends on it."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Login returns 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const body = pm.response.json();",
                  "const token = body.data && body.data.token;",
                  "pm.test('Response contains a token', function () {",
                  "  pm.expect(token).to.be.a('string').and.not.empty;",
                  "});",
                  "if (token) {",
                  "  pm.environment.set('token', token);",
                  "}"
                ]
              }
            }
          ]
        }
      ]
