    {
      "name": "Analytics (Admin)",
      "item": [
        {
          "name": "GET Operational Analytics (defaults)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/analytics/operational",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "analytics",
                "operational"
              ],
              "query": []
            },
            "description": "FS-15/IP-17. The read-only Operational Analytics aggregation. With no query parameters it defaults to the last 30 days, all Branches, all detection types, bucketed daily in UTC. Every value is derived from the Alerts already persisted by FS-06 sync; nothing is seeded. Note there is deliberately no accuracy/precision/false-positive field: AlertStatus has a single member, so the database holds no human-validated ground truth (summary.validationDataAvailable is always false)."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Operational analytics returns 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Defaults to a 30-day daily-bucketed window', function () {",
                  "  const data = pm.response.json().data;",
                  "  pm.expect(data.filters.range).to.eql('last30d');",
                  "  pm.expect(data.filters.bucket).to.eql('day');",
                  "});",
                  "pm.test('Never claims validation ground truth exists', function () {",
                  "  const summary = pm.response.json().data.summary;",
                  "  pm.expect(summary.validationDataAvailable).to.eql(false);",
                  "  pm.expect(JSON.stringify(summary)).to.not.match(/accuracy|precision|falsePositive/i);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "GET Operational Analytics (Branch + detection type)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/analytics/operational?range=last7d&branchId={{branchId}}&detectionType=gun",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "analytics",
                "operational"
              ],
              "query": [
                {
                  "key": "range",
                  "value": "last7d"
                },
                {
                  "key": "branchId",
                  "value": "{{branchId}}"
                },
                {
                  "key": "detectionType",
                  "value": "gun"
                }
              ]
            },
            "description": "The same endpoint with all three filters applied. A Branch is always identified by its BranchId GUID, never by its display name. detectionType accepts only the platform's real taxonomy (gun, knife) — anything else is a 400."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Filtered analytics returns 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Echoes the filters that were applied', function () {",
                  "  const filters = pm.response.json().data.filters;",
                  "  pm.expect(filters.range).to.eql('last7d');",
                  "  pm.expect(filters.detectionType).to.eql('gun');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "GET Operational Analytics (invalid detection type -> 400)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/analytics/operational?detectionType=intrusion",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "analytics",
                "operational"
              ],
              "query": [
                {
                  "key": "detectionType",
                  "value": "intrusion"
                }
              ]
            },
            "description": "A class outside the platform's taxonomy is rejected rather than silently ignored."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Unknown detection type is rejected', function () {",
